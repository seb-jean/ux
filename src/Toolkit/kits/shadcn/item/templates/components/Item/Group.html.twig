{# @block content The grouped items, typically multiple `Item` components #}
<div
    class="{{ ('group/item-group flex flex-col ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({
        'data-slot': 'item-group',
        role: 'list',
    }) }}
>
    {%- block content %}{% endblock -%}
</div>
